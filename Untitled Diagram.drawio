        <mxCell id="IWNJmw801ZjH4X6JTXCK-64" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="1.Các thực thể gồm:&amp;nbsp;Sinh viên,&amp;nbsp;Môn học, Giảng viên, lớp học phần, và thực thể yếu Đăng ký&lt;br&gt;&lt;br&gt;2. Mối quan hệ giữa các thực thể&lt;div&gt;&lt;ul&gt;&lt;li&gt;Giảng viên – Lớp học phần: 1-n&lt;/li&gt;&lt;li&gt;Môn học – Lớp học phần:1 – n&lt;/li&gt;&lt;li&gt;Sinh viên – Lớp học phần:n-n&amp;nbsp;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;4.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;4.1 Khóa chính&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Thực thể Sinh viên: Khóa chính là Mã sinh viên&lt;/li&gt;&lt;li&gt;Thực thể Môn học: Khóa chính là Mã môn&lt;/li&gt;&lt;li&gt;Thực thể Giảng viên: Khóa chính là Mã giảng viên&lt;/li&gt;&lt;li&gt;Thực thể Lớp học phần: Khóa chính là Mã lớp học phần&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;4.2&amp;nbsp;Khóa ngoại&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Tại thực thể Lớp học phần: Có 2 khóa ngoại là Mã môn và Mã giảng viên&amp;nbsp;&lt;/li&gt;&lt;li&gt;Tại thực thể trung gian Đăng ký: Có 2 khóa ngoại là Mã sinh viên và Mã lớp học phần .&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="420" x="90" y="320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
